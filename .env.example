# Copy this file to .env and fill in your free-tier keys.
# Never commit the real .env file.

# --- Web search (free tier: 1,000 credits/month, no card) ---
# Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Academic papers ---
# ArXiv needs no key at all.
# Semantic Scholar works without a key (shared/low rate limit) but a free
# key gives you a dedicated, higher limit. Request one at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# --- LLMs (both free tier) ---
# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model must be an id from https://ai.google.dev/gemini-api/docs/pricing
# that shows "Free of charge". gemini-2.5-flash is a safe default.
GEMINI_MODEL=gemini-2.5-flash

# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- App defaults (safe to leave as-is) ---
DEFAULT_WEB_RESULTS=5
DEFAULT_PAPER_RESULTS=5
REQUEST_TIMEOUT_SECONDS=20
