# Copy this file to .env and fill in your free-tier keys.
# Never commit the real .env file.

# --- Web search (free tier: 1,000 credits/month, no card) ---
# Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Academic papers ---
# ArXiv needs no key at all.
# Semantic Scholar works without a key (shared/low rate limit) but a free
# key gives you a dedicated, higher limit. Request one at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# --- LLMs (both free tier) ---
# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model must be an id from https://ai.google.dev/gemini-api/docs/pricing
# that shows "Free of charge". gemini-2.5-flash is a safe default.
GEMINI_MODEL=gemini-2.5-flash

# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- App defaults (safe to leave as-is) ---
DEFAULT_WEB_RESULTS=5
DEFAULT_PAPER_RESULTS=5
REQUEST_TIMEOUT_SECONDS=20

# --- Frontend / CORS ---
# Comma-separated origins allowed to call this API. The Next.js dev server
# runs on :3000. Use "*" to allow any origin (local dev only).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional Supabase auth (leave blank for anonymous-only) ---
# Only needed if you enable sign-in + the saved library on the frontend.
# JWT secret: Supabase dashboard → Project Settings → API → JWT Secret.
# When set, the API recognizes signed-in users from their bearer token but
# still never requires one — anonymous research keeps working.
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# --- Persistence (Phase 11) ---
# Saved library storage. SQLite by default (zero setup, local file). In
# production point this at Supabase's Postgres. IMPORTANT: use the pg8000
# driver prefix, e.g.
#   DATABASE_URL=postgresql+pg8000://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///.cache/apex_research.db

# --- Optional Supabase Storage (Phase 11) ---
# Offloads rendered PDFs / chart PNGs to a bucket and returns signed URLs.
# Leave blank and reports still fully reconstruct from the database.
# The service-role key is a SECRET — backend only, never the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=reports

# --- Multi-model routing (Phase 12) ---
# With a Groq key present, light stages use a fast small model and heavy
# reasoning stays on Gemini; each call falls back to the other provider.
LLM_ROUTING_ENABLED=true
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- New free retrieval sources (Phase 12, all keyless) ---
ENABLE_OPENALEX=true
ENABLE_PUBMED=true
ENABLE_CROSSREF=true
ENABLE_WIKIPEDIA=true
# Optional: identifies you to Crossref's faster "polite pool".
CROSSREF_MAILTO=

# --- Rate limiting / quotas (Phase 12) ---
# Off by default. Turn on for shared/public deploys. Resets daily (UTC).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_DAY=50
RATE_LIMIT_ANON_PER_DAY=10

# --- Retrieval cache backend (Phase 12) ---
# "sqlite" (local file), "postgres" (reuse DATABASE_URL), or "redis" (REDIS_URL).
# Pick postgres or redis in production — host filesystems are ephemeral.
CACHE_BACKEND=sqlite
REDIS_URL=

# --- Error monitoring (Phase 13, optional) ---
# Blank disables Sentry (no-op). Get a free DSN at https://sentry.io
# Requires the optional dependency: pip install sentry-sdk
SENTRY_DSN=
APP_ENV=development
# 0.0 = errors only. Raise toward 1.0 to sample performance traces (uses more
# of the free-tier event quota).
SENTRY_TRACES_SAMPLE_RATE=0.0
