# Copy this file to `.env.local` and fill in the values you need.
# Everything here is optional — with none of it set, the app still runs:
# it points at a local backend and stays in anonymous mode (no sign-in,
# no saved library).

# --- Backend API ---
# Where the FastAPI backend is reachable. Defaults to http://localhost:8000
# if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Supabase (optional: enables sign-in + the saved library) ---
# Both must be set for auth to turn on. Find them in your Supabase project:
#   Project Settings → API → Project URL   and   Project API keys → anon public
# Leave blank to run fully anonymously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Error monitoring (optional, dependency-free) ---
# Set a Sentry DSN to turn on lightweight client-side error reporting. Blank =
# off (no-op). This uses a tiny built-in reporter — no @sentry/nextjs package
# required, so it never affects your build. See DEPLOY.md to switch to the full
# official SDK instead.
NEXT_PUBLIC_SENTRY_DSN=
# Optional labels attached to reported events (both default sensibly if unset).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
